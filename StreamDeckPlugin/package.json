{
  "name": "switchboard-streamdeck-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck plugin for Switchboard: run macros and actions from keys, show live desk state on tiles.",
  "license": "MIT",
  "author": "Felipe Giannazzo",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart io.github.fgiannazzo.switchboard\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "validate": "streamdeck validate io.github.fgiannazzo.switchboard.sdPlugin",
    "pack": "streamdeck pack io.github.fgiannazzo.switchboard.sdPlugin --output dist --force",
    "link": "streamdeck link io.github.fgiannazzo.switchboard.sdPlugin",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "rollup": "4.64.5",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
